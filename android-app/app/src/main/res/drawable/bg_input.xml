<?xml version="1.0" encoding="utf-8"?>
<!-- Kotak isian: sudut membulat, garis tepi halus, latar gelap.
     Menggantikan @android:drawable/editbox_background (kotak abu-abu Android lama). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#0b1220" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#3b82f6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0b1220" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#243044" />
        </shape>
    </item>
</selector>
